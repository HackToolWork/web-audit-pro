# Web Audit Pro configuration. CLI arguments override these values.

[scan]
threads = 10
requests_per_second = 2.0
timeout = 5.0
output_dir = "reports"

[features]
dns = true
cms = true
scan_js = true
tui = false

[report]
company = "Security Assessment Team"
theme = "dark"

[nvd]
nvd_timeout = 12.0

# For a personal setup you can also add: proxy, scope_file, paths_file,
# allow_private, insecure_tls, discover_subdomains, and dashboard settings.
